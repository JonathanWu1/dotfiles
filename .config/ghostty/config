cursor-style=block
shell-integration-features=no-cursor
font-feature=-calt

keybind=ctrl+f5=reload_config
keybind=super+up=toggle_maximize

keybind=ctrl+enter=unbind
keybind=ctrl+shift+o=unbind
keybind=ctrl+shift+e=unbind

gtk-wide-tabs=false

background-opacity=0.85
window-theme=ghostty
background=#232136
window-decoration=server

gtk-custom-css=~/.config/ghostty/ghostty.css

window-padding-x=10
window-padding-y=10

