# Added by Toolbox App
export PATH="$PATH:/home/jonathanwu/.local/share/JetBrains/Toolbox/scripts"
export PATH="$PATH:/usr/bin:/usr/sbin:/sbin/bin"
export PATH="$PATH:$HOME/.local/share/fnm/aliases/default/bin"
export PATH="$PATH:$HOME/.dotnet"
export PATH="$PATH:$HOME/.dotnet/tools"
export PATH="$PATH:$HOME/source/azd-linux"
export PATH="$PATH:$HOME/.config/nvm/alias/default"


export DOTFILES="$HOME/dotfiles"
export CONFIGS_DIR="$HOME/dotfiles/.config"
export ZDOTDIR="$DOTFILES"
export GIT_EDITOR=nvim

alias bash="bash --rcfile $DOTFILES/.bashrc"
export XDG_CONFIG_HOME="$HOME/.config"
